import { roll } from "modules/roller";

random.seed(123);
variable first: int = roll();
variable second: int = roll();
random.seed(123);
assert(first == roll(), "seed did not control module randomness");
assert(second == roll(), "module sequence did not repeat");

random.seed(123);
variable initial: int = roll();
variable found_different: bool = false;
for i: int in 0..20 {
    variable value: int = roll();
    if value != initial {
        found_different = true;
    }
}
assert(found_different, "successive module rolls never differed");
